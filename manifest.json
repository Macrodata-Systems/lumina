{
    "manifest_version": 3,
    "name": "Lumina",
    "version": "1.1",
    "author": "Harsh Raj Singh",
    "description": "Explain anything on your screen - Slides, Papers, News, Articles - using Gemini, OpenAI, and Claude.",
    "permissions": [
        "activeTab",
        "storage",
        "sidePanel",
        "scripting",
        "clipboardRead",
        "geolocation"
    ],
    "host_permissions": [
        "<all_urls>",
        "https://api.gumroad.com/*"
    ],
    "action": {
        "default_title": "Lumina",
        "default_icon": {
            "16": "assets/icon16.png",
            "32": "assets/icon32.png",
            "48": "assets/icon.png",
            "128": "assets/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "assets/icon16.png",
        "32": "assets/icon32.png",
        "48": "assets/icon.png",
        "128": "assets/icon128.png"
    }
}
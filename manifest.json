{
    "manifest_version": 3,
    "name": "Lumina - AI Copilot for the web",
    "version": "1.4",
    "author": "Harsh Raj Singh",
    "description": "Explain anything on your screen - Slides, Papers, News, Articles - using ChatGPT, Gemini and Claude.",
    "permissions": [
        "activeTab",
        "storage",
        "contextMenus",
        "scripting",
        "clipboardRead",
        "tabs",
        "management",
        "notifications",
        "sidePanel"
    ],
    "chrome_url_overrides": {
        "newtab": "desktop.html"
    },
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "all_frames": true
        }
    ],
    "action": {
        "default_title": "Lumina",
        "default_icon": {
            "16": "assets/icon16.png",
            "32": "assets/icon32.png",
            "48": "assets/icon48.png",
            "128": "assets/icon128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "commands": {
        "silent_java_solver": {
            "suggested_key": {
                "default": "Ctrl+Shift+1",
                "mac": "Command+Shift+1"
            },
            "description": "Silent capture and Java,Python solve"
        },
        "silent_system_design": {
            "suggested_key": {
                "default": "Ctrl+Shift+2",
                "mac": "Command+Shift+2"
            },
            "description": "Silent capture and System Design help"
        },
        "silent_code_review": {
            "suggested_key": {
                "default": "Ctrl+Shift+6",
                "mac": "Command+Shift+6"
            },
            "description": "Silent capture and Code Review"
        },
        "show_lumina_architecture": {
            "suggested_key": {
                "default": "Ctrl+Shift+L",
                "mac": "Command+Shift+L"
            },
            "description": "Show Lumina Architecture"
        }
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "icons": {
        "16": "assets/icon16.png",
        "32": "assets/icon32.png",
        "48": "assets/icon48.png",
        "128": "assets/icon128.png"
    }
}